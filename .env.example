# PHK Studio
PHK_APP_NAME=PHK Studio
PHK_APP_VERSION=0.3.0
PHK_ENVIRONMENT=development
PHK_DEBUG=true

# Server
PHK_HOST=127.0.0.1
PHK_PORT=8000

# Database
PHK_DATABASE_URL=sqlite:///./data/phk_studio.db

# Logging
PHK_LOG_LEVEL=INFO
PHK_LOG_JSON=false

# PHK Shield
PHK_SHIELD_ENABLED=true
PHK_QUARANTINE_PATH=quarantine
PHK_SECURITY_LOG_PATH=logs/security

# Security
PHK_SECRET_KEY=replace-with-a-long-random-secret
PHK_ALLOWED_HOSTS=127.0.0.1,localhost